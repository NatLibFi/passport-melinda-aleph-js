{
	"name": "@natlibfi/passport-melinda-aleph",
	"description": "Passport authentication strategy for Melinda using Aleph credentials",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://www.npmjs.com/package/@natlibfi/passport-melinda-aleph",
	"bugs": {
		"url": "https://github.com/natlibfi/passport-melinda-aleph-js/issues"
	},
	"repository": {
		"url": "https://github.com/NatLibFi/passport-melinda-aleph-js"
	},
	"license": "MIT",
	"version": "5.0.0",
	"main": "./dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "rm -rf dist && tsc",
		"typecheck": "tsc -p tsconfig.check.json",
		"lint": "eslint src",
		"lint:dev": "eslint --fix src",
		"test:base": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './test/*.test.ts'",
		"dev:test": "cross-env DEBUG=@natlibfi/* LOG_LEVEL=debug NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './test/*.test.ts'",
		"test": "npm run lint && npm run typecheck && npm run test:base"
	},
	"dependencies": {
		"@natlibfi/melinda-commons": "^16.0.0",
		"@xmldom/xmldom": "^0.9.12",
		"debug": "^4.4.3",
		"http-status": "^2.1.0",
		"passport": "^0.7.0",
		"passport-http": "^0.3.0"
	},
	"devDependencies": {
		"@types/debug": "^4.1.13",
		"@types/node": "^26.6.6",
		"@types/passport-http": "^0.3.11",
		"cross-env": "^10.1.0",
		"eslint": "^10.14.0",
		"jiti": "^2.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"undici": "^8.12.4",
		"undici-types": "^8.12.4"
	}
}
